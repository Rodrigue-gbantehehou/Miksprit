APP_ENV=dev
APP_SECRET=replace-with-a-random-local-secret
APP_SHARE_DIR=/var/lib/miksprit

PAYMENT_RETURN_URL=https://portal.example.com/portal
PAYMENT_DEFAULT_PROVIDER=fedapay
PLATFORM_SUBSCRIPTION_PROVIDER=
PLATFORM_SUBSCRIPTION_RETURN_URL=https://portal.example.com/abonnement
PLATFORM_SUBSCRIPTIONS_REQUIRED=0
FEDAPAY_ENABLED=0
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com/v1
FEDAPAY_PAYOUTS_ENABLED=0
PLATFORM_COMMISSION_BPS=__UNCONFIGURED__

TENANT_PAYMENT_ENCRYPTION_KEY=
VOUCHER_CREDENTIAL_ENCRYPTION_KEY=
ROUTEROS_HOTSPOT_PROFILE=default
ROUTER_ALLOWED_HOSTS=
ROUTER_CREDENTIAL_ENCRYPTION_KEY=

DEFAULT_URI=http://localhost
DATABASE_URL="mysql://app:change-me@127.0.0.1:3306/db_miksprit?serverVersion=8.0.32&charset=utf8mb4"
MAILER_DSN=null://null
MAILER_FROM=no-reply@example.com
AUTH_PUBLIC_BASE_URL=http://localhost:3002
AUTH_COOKIE_DOMAIN=

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
